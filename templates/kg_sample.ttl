    dcterms:created "2026-01-01"^^xsd:date ;
    wf:content "# L'alba di tutto\n\n*L'alba di tutto: una nuova storia dell'umanità* (2021, ed. it. 2022) è scritto da David Graeber e David Wengrow. Rifiuta il racconto lineare che va da cacciatori-raccoglitori \"infantili\" a civiltà gerarchiche, mostrando che i nostri antenati sperimentavano già libertà, eguaglianz..." ;
    prov:wasAttributedTo wfid:agent-anonymus ;
    wf:refersTo wfid:david-graeber ;
    wf:refersTo wfid:debito-primi-5000-anni ;
    wf:refersTo wfid:bullshit-jobs .

