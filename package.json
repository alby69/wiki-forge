{
  "name": "wiki-forge-ui",
  "version": "4.1.0",
  "private": true,
  "description": "Decoupled Web User Interface & Obsidian-style Graph Viewer for Wiki-Forge",
  "scripts": {
    "dev": "vite",
    "api": "node --import tsx src/backend/server/httpServer.ts",
    "dev:all": "node scripts/devAll.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "cron-parser": "^5.10.6",
    "force-graph": "^1.51.4",
    "marked": "^12.0.0",
    "smol-toml": "^1.8.0",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vite": "^8.3.1"
  }
}
