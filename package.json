{
  "name": "wiki-forge-ui",
  "version": "4.1.0",
  "private": true,
  "description": "Decoupled Web User Interface & Obsidian-style Graph Viewer for Wiki-Forge",
  "scripts": {
    "dev": "vite",
    "api": "node --import tsx src/backend/server/httpServer.ts",
    "dev:all": "node scripts/devAll.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:coverage": "PYTHONPATH=.:scripts python3 -m pytest -q tests/python/ --cov=scripts --cov-report=term-missing --cov-fail-under=24",
    "test:coverage:semantics": "PYTHONPATH=.:scripts python3 -m pytest -q tests/python/ --cov=src/backend/wikiforge/semantics --cov-report=term-missing --cov-fail-under=64",
    "test:coverage:ts": "node --import tsx --experimental-test-coverage --test tests/*.test.ts",
    "test:coverage:ts:check": "node scripts/check_ts_coverage.mjs",
    "manifest": "node --import tsx scripts/gen_command_manifest.mjs",
    "manifest:check": "node --import tsx scripts/gen_command_manifest.mjs --check",
    "python-contract": "python3 scripts/export_python_openapi.py && node scripts/gen_python_api_client.mjs",
    "python-contract:check": "python3 scripts/export_python_openapi.py --check && node scripts/gen_python_api_client.mjs --check",
    "eval:check": "python3 tests/eval/run_eval.py",
    "verify": "python3 scripts/check_docs_sync.py && python3 scripts/docs_to_wiki.py --check && python3 scripts/docs_book.py --check && python3 scripts/gen_script_registry.py --check && npm run manifest:check && npm run python-contract:check && npm run typecheck && npm run build && npm test && npm run test:coverage && npm run test:coverage:semantics && npm run test:e2e && PYTHONPATH=.:scripts python3 -m pytest -q tests/python/ && npm run eval:check && npm run test:coverage:ts:check",
    "wf": "node --import tsx bin/wf.ts",
    "mcp": "node --import tsx bin/mcp.ts",
    "worker": "node --import tsx bin/worker.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "^1.10.0",
    "ajv": "^8.20.0",
    "commander": "^15.1.0",
    "cron-parser": "^5.10.6",
    "force-graph": "^1.52.0",
    "marked": "^12.0.0",
    "smol-toml": "1.9.1",
    "swagger-ui-dist": "^5.35.1",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.19.43",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vite": "8.4.0"
  }
}
